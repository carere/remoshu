{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["esnext", "webworker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types", "bun"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"]
}
