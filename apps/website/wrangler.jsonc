{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remoshu-website",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "remoshu.carere.dev", "custom_domain": true }]
}
