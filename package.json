{
  "name": "remoshu",
  "version": "0.1.0",
  "private": true,
  "description": "A moon HTTP remote cache for Cloudflare Workers and R2",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "moon run :build",
    "check": "biome check --no-errors-on-unmatched .",
    "deploy": "moon run cache:deploy",
    "deploy:website": "moon run website:deploy",
    "dev": "moon run website:dev",
    "dev:cache": "moon run cache:dev",
    "fix": "biome check --write --no-errors-on-unmatched .",
    "provision": "bun run --cwd services/cache provision",
    "test": "moon run cache:test-unit cache:test-integration",
    "test:e2e": "moon run cache:test-e2e",
    "test:integration": "moon run cache:test-integration",
    "test:unit": "moon run cache:test-unit",
    "typecheck": "moon run :typecheck",
    "types": "moon run cache:types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@moonrepo/cli": "2.5.4",
    "typescript": "7.0.2"
  }
}
